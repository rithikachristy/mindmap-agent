# AI Mind-Map Agent Environment Variables

# LLM Provider: "openrouter" or "anthropic"
MINDMAP_PROVIDER=openrouter

# Model selection
# For OpenRouter: "openai/gpt-4-turbo", "anthropic/claude-3-opus", etc.
# For Anthropic: "claude-3-opus-20240229", etc.
MINDMAP_MODEL=openai/gpt-4-turbo

# OpenRouter API Key
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Anthropic API Key (if using Anthropic provider)
# Get from: https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
